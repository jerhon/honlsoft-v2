{
  "include": [
    "./.vitepress/**/*.ts",
    "./.vitepress/**/*.mts",
    "./tag/**/*.ts"
  ],
  "exclude": [
    "./node_modules",
    "./public",
    "./src",
    "./plugins",
    "./pages",
    "./gatsby-browser.js",
    "./gatsby-config.ts",
    "./gatsby-node.ts",
    "./gatsby-ssr.js"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitepress/client"]
  }
}
